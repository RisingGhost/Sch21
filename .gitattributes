# Normalize line endings
* text=auto

# Python
*.py text eol=lf

# Markdown
*.md text eol=lf

# Text/config files
*.txt text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf

# Jupyter notebooks
*.ipynb text eol=lf

# Images
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.svg text eol=lf

# Archives
*.zip binary
*.tar binary
*.gz binary